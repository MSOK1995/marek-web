// PRODUCTION config for thechiropractor.at. Deployed by .github/workflows/deploy.yml on every push to main.
// Build:   python build.py --prod
// Deploy:  npx wrangler deploy -c wrangler.prod.jsonc   (only after the domain is on Cloudflare)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thechiropractor-at",
  "compatibility_date": "2026-09-25",
  // no public *.workers.dev copy of the production site
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
  // The domains thechiropractor.at and www.thechiropractor.at are attached in the dashboard
  // (Workers & Pages -> thechiropractor-at -> Settings -> Domains & Routes -> Add -> Custom domain),
  // so the API token needs no zone permissions. Deploys without "routes" leave them in place.
}
